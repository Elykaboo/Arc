rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotSuspended(uid) {
      return !exists(/databases/$(database)/documents/members/$(uid))
        || get(/databases/$(database)/documents/members/$(uid)).data.accountStatus != "suspended";
    }

    function canWriteAsSelf(userId) {
      return isSelf(userId) && isNotSuspended(request.auth.uid);
    }

    match /{path=**}/following/{targetUid} {
      allow read: if true;
    }

    match /{path=**}/profile/{profileDocId} {
      allow read: if profileDocId == "details";
    }

    match /users/{userId}/following/{targetUid} {
      allow read: if true;
      allow write: if canWriteAsSelf(userId);
    }

    match /users/{userId}/followers/{followerUid} {
      allow read: if true;
      allow write: if isSelf(followerUid) && isNotSuspended(request.auth.uid);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSelf(userId);
      allow create: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && request.resource.data.recipientUid == userId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type in ["follow", "comment", "like"];
      allow update, delete: if canWriteAsSelf(userId);
    }

    match /users/{userId}/profile/details {
      allow read: if true;
      allow write: if canWriteAsSelf(userId);
    }

    match /users/{userId}/{document=**} {
      allow read: if isSelf(userId);
      allow write: if canWriteAsSelf(userId);
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && resource.data.uid == request.auth.uid;
    }

    match /communityComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && (
          resource.data.uid == request.auth.uid
          || resource.data.postOwnerUid == request.auth.uid
        );
    }

    match /communityLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.postId is string
            && get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.uid == request.auth.uid
          )
        );
    }

    match /communityCommentLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && isNotSuspended(request.auth.uid)
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.commentId is string
            && get(/databases/$(database)/documents/communityComments/$(resource.data.commentId)).data.postOwnerUid == request.auth.uid
          )
        );
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if canWriteAsSelf(userId);
    }

    match /members/{userId} {
      allow read: if true;
      allow write: if canWriteAsSelf(userId);
    }

    match /admins/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }
  }
}
